{
  "name": "bbe-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node -e \"const fs=require('fs');const path=require('path');const envPath=path.join(__dirname,'../.env');const envContent=fs.readFileSync(envPath,'utf8');const lines=envContent.split('\\n').filter(line=>line.trim()!=='');const viteEnv=lines.filter(line=>line.startsWith('VITE_')||line.startsWith('SWAGGER_HOST=')).map(line=>line.trim()).join('\\n');fs.writeFileSync('.env',viteEnv);console.log('Copied environment variables to bbe-ui/.env');\"",
    "build": "npm run prebuild && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@g-loot/react-tournament-brackets": "^1.0.31-rc",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-virtual": "^3.13.18",
    "framer-motion": "^12.23.11",
    "gsap": "^3.13.0",
    "keycloak-js": "^26.2.2",
    "ogl": "^1.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.3.0",
    "simple-parallax-js": "^6.2.1",
    "swagger-ui-react": "^5.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^1.0.4"
  }
}
