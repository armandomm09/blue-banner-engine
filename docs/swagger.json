    "definitions": {
        "clients.TeamYearMetric": {
            "type": "object",
            "properties": {
                "competing": {
                    "type": "object",
                    "properties": {
                        "next_event_key": {
                            "type": "string"
                        },
                        "next_event_name": {
                            "type": "string"
                        },
                        "next_event_week": {
                            "type": "integer"
                        },
                        "this_week": {
                            "type": "boolean"
                        }
                    }
                },
                "country": {
                    "type": "string"
                },
                "district": {
                    "type": "string"
                },
                "epa": {
                    "type": "object",
                    "properties": {
                        "auto_points": {
                            "type": "number"
                        },
                        "endgame_points": {
                            "type": "number"
                        },
                        "mean": {
                            "type": "number"
                        },
                        "rp_1": {
                            "type": "number"
                        },
                        "rp_2": {
                            "type": "number"
                        },
                        "rp_3": {
                            "type": "number"
                        },
                        "teleop_points": {
                            "type": "number"
                        },
                        "tiebreaker_points": {
                            "type": "number"
                        },
                        "total_points": {
                            "type": "number"
                        },
                        "unitless": {
                            "type": "number"
                        }
                    }
                },
                "name": {
                    "type": "string"
                },
                "record": {
                    "type": "object",
                    "properties": {
                        "count": {
                            "type": "integer"
                        },
                        "losses": {
                            "type": "integer"
                        },
                        "ties": {
                            "type": "integer"
                        },
                        "winrate": {
                            "type": "number"
                        },
                        "wins": {
                            "type": "integer"
                        }
                    }
                },
                "rookie_year": {
                    "type": "integer"
                },
                "state": {
                    "type": "string"
                },
                "team": {
                    "type": "integer"
                },
                "year": {
                    "type": "integer"
                }
            }
        },
        "routes.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "routes.FTCMatch": {
            "type": "object",
