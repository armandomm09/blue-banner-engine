                "parameters": [
                    {
                        "type": "string",
                        "description": "FTC Season (e.g., 2024)",
                        "name": "season",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "FTC Event Code (e.g., TXHOU)",
                        "name": "eventCode",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
