                "parameters": [
                    {
                        "type": "string",
                        "description": "FTC Season (e.g., 2024)",
                        "name": "season",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "FTC Event Code (e.g., TXHOU)",
                        "name": "eventCode",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/routes.FTCTeam"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/metrics/metadata": {
            "get": {
                "description": "Returns a list of all available metrics for visualization.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get Metric Metadata",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/routes.MetricDefinition"
                            }
                        }
                    }
                }
            }
        },
        "/predict/event/{event_key}": {
            "get": {
                "description": "Retrieves all match predictions for a given FRC event key from the BBE prediction service.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "predictions"
                ],
                "summary": "Get All Match Predictions for an Event",
                "parameters": [
                    {
                        "type": "string",
                        "description": "FRC Event Key (e.g., 2025mxle)",
                        "name": "event_key",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful prediction for all matches",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/types.MatchPrediction"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error (e.g., gRPC call failed)",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/predict/event/{event_key}/playoff/{n_sims}": {
            "get": {
                "description": "Using matchpoint predictor, simulates the playoff results for an event",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "predictions"
                ],
                "summary": "Get the playoff simulated n times for an Event",
                "parameters": [
                    {
                        "type": "string",
                        "description": "FRC Event Key (e.g., 2025mxle)",
                        "name": "event_key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of desired simulations (e.g., 1000)",
                        "name": "n_sims",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful prediction for all matches",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/types.SimulationResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error (e.g., gRPC call failed)",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/predict/match/{match_key}": {
            "get": {
                "description": "Retrieves a detailed prediction for a single FRC match, including SHAP analysis for model explainability.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "predictions"
                ],
                "summary": "Get Single Match Prediction with SHAP",
                "parameters": [
                    {
                        "type": "string",
                        "description": "FRC Match Key (e.g., 2025mxle_qm12)",
                        "name": "match_key",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful prediction",
                        "schema": {
                            "$ref": "#/definitions/types.MatchPrediction"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error (e.g., gRPC call failed)",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/statbotics/team/{teamNumber}/metrics": {
            "get": {
                "description": "Fetches EPA and other metrics from Statbotics for a specific team and year.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get Statbotics Metrics for a Team",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Team Number",
                        "name": "teamNumber",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Year (default: current year)",
                        "name": "year",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/clients.TeamYearMetric"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/routes.ErrorResponse"
                        }
                    }
                }
            }
        },
