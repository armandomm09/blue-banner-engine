                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get TBA Metrics for a Team",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Team Number",
                        "name": "teamNumber",
                        "in": "path",
